# ============================================================
# Nexus RAG Privacy App - Environment Configuration
# 复制此文件为 .env 并填入实际值
# ============================================================

# --- 数据库配置 (MySQL) ---
DATABASE_URL=mysql+pymysql://root:123456@localhost/patent_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=patent_db

# --- LLM API 配置 ---
LLM_URL=http://100.106.140.63:8080/v1/chat/completions
LLM_API_KEY=

# --- 应用配置 ---
SECRET_KEY=your_default_secret_key
FLASK_ENV=production
FLASK_DEBUG=0

# --- 检索后端配置 ---
# 可选值: notes | faiss | hybrid
RETRIEVAL_BACKEND=faiss
NEXUS_RETRIEVER=faiss

# --- TriviaQA 知识库配置 ---
TRIVIAQA_KB_DIR=./triviaqa_kb

# --- 混合检索权重 (仅 hybrid 后端生效) ---
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3

# --- Hugging Face 配置 ---
# 国内用户可设置镜像加速
# HF_ENDPOINT=https://hf-mirror.com

# --- 嵌入模型配置 ---
# NEXUS_EMBED_FALLBACK_ONLY=1

# --- 模拟性能采集参数 ---
NEXUS_SIM_BANDWIDTH_MBPS=50
NEXUS_SIM_RTT_MS=30
NEXUS_SIM_BATTERY_PERCENT=80